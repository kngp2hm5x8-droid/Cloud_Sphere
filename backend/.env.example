NODE_ENV=development
PORT=4000
# Application role (DML only). Used by the API.
DATABASE_URL=postgresql://cloudsphere_app:CHANGE_ME@localhost:5432/cloudsphere
# Migration role (owns the schema). Used by the migration runner in Phase 2.
MIGRATOR_DATABASE_URL=postgresql://cloudsphere_migrator:CHANGE_ME@localhost:5432/cloudsphere
CORS_ORIGIN=http://localhost:5173
DB_POOL_MAX=10
